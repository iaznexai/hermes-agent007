# ==============================================================================
# Hermes Web UI — Docker Compose Environment Template
# ==============================================================================
#
# This file is a TEMPLATE.
#
# Copy it to `.env` next to your docker-compose.yml:
#
#     cp .env.example .env
#
# Replace every value enclosed in <...> with values appropriate for your
# installation.
#
# Never commit your real `.env` file.
#
# ==============================================================================


# ==============================================================================
# UID / GID — host user mapping
# ==============================================================================
#
# Required when bind-mounting an existing Hermes home directory.
#
# Find your values:
#
#   id -u
#   id -g
#
# Linux commonly uses 1000 for the first user.
# macOS commonly starts at 501.
#
UID=1000
GID=1000


# ==============================================================================
# Hermes home directory
# ==============================================================================
#
# Default:
#
#     ~/.hermes
#
# Uncomment only if you use another location.
#
# HERMES_HOME=/opt/hermes


# ==============================================================================
# Workspace directory
# ==============================================================================
#
# Default:
#
#     ~/workspace
#
# Uncomment if your projects live elsewhere.
#
# HERMES_WORKSPACE=/home/me/projects


# ==============================================================================
# WebUI configuration
# ==============================================================================

HERMES_WEBUI_STATE_DIR=/home/hermeswebui/.hermes/webui
WIKI="${WIKI_PATH:-$HOME/wiki}"

# REQUIRED when exposing the WebUI beyond localhost.
HERMES_WEBUI_PASSWORD=<strong-password>


# ==============================================================================
# Dashboard authentication
# ==============================================================================

HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<strong-password>

# Generate with:
#
#     openssl rand -base64 32
#
HERMES_DASHBOARD_BASIC_AUTH_SECRET=<generate-with-openssl-rand-base64-32>

HERMES_TOOL_FORMAT=xml


# ==============================================================================
# Permission handling (advanced)
# ==============================================================================
#
# The WebUI normally enforces secure permissions (0600) on credential files.
#
# Disable permission fixing:
#
# HERMES_SKIP_CHMOD=1
#
# Allow group-readable credentials:
#
# HERMES_HOME_MODE=0640
#
# Multi-container note:
#
# The WebUI and Hermes Agent interpret HERMES_HOME_MODE differently.
# For multi-container deployments use 0750 (or similar), NOT 0640,
# otherwise the Hermes Agent cannot enter its own home directory.
#


# ==============================================================================
# Multi-container deployments
# ==============================================================================
#
# docker-compose.two-container.yml
# docker-compose.three-container.yml
#
# Named Docker volumes are recommended.
#
# If you replace them with bind mounts, ALL containers must:
#
#   • mount the same host directory
#   • run as the same UID/GID
#
# Otherwise permission errors will occur.


# ==============================================================================
# Zotero
# ==============================================================================

# API key:
#
# https://www.zotero.org/settings/keys
#
ZOTERO_API_KEY=<zotero-api-key>

# Numeric Zotero user ID.
ZOTERO_USER_ID=<zotero-user-id>

# "users" or "groups"
ZOTERO_LIBRARY_TYPE=users

# Only required when using group libraries.
ZOTERO_GROUP_ID=

# Self-hosted WebDAV endpoint.
#
# Example:
#
# https://zotero-webdav.example.com/webdav/zotero/
#
ZOTERO_WEBDAV_URL=https://zotero-webdav.example.com/webdav/zotero/

ZOTERO_WEBDAV_USER=<webdav-username>
ZOTERO_WEBDAV_PASSWORD=<webdav-password>

# Optional
ZOTERO_PAGE_LIMIT=100

# Optional
ZOTERO_CACHE_DIR=~/.cache/hermes/zotero

# Optional
ZOTERO_DEFAULT_COLLECTION=


# ==============================================================================
# Slack
# ==============================================================================

SLACK_BOT_TOKEN=<slack-bot-token>

SLACK_APP_TOKEN=<slack-app-token>

SLACK_ALLOWED_USERS=<comma-separated-slack-user-ids>

# Optional
SLACK_HOME_CHANNEL=<channel-id>

# Optional
SLACK_HOME_CHANNEL_NAME=<channel-name>
